# Spotify app client id -- https://developer.spotify.com/dashboard
# Register the redirect URI that matches how you open the app, e.g.
#   https://192.168.1.20:5173/
# (Spotify requires https for non-loopback redirect URIs.)
VITE_SPOTIFY_CLIENT_ID=92ecc13ff2084d65a5059db004d6366d

# Server-only Neon connection strings. Never prefix these with VITE_.
# Copy the pooled connection string from Neon, including its SSL parameters.
DATABASE_URL=
# Optional direct (non-pooler) connection string for Prisma migrations.
DIRECT_URL=
