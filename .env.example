# Server-only Neon connection strings. Never prefix these with VITE_.
# Copy the pooled connection string from Neon, including its SSL parameters.
DATABASE_URL=
# Optional direct (non-pooler) connection string for Prisma migrations.
DIRECT_URL=

# Server-only owner for the shared personal library (not an authenticated account).
LIBRARY_OWNER_ID=personal-import

# Optional public Spotify client ID for browser playback. Never put a secret here.
VITE_SPOTIFY_CLIENT_ID=
